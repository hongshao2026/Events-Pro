# Keep disabled until the account service and Google/email settings are ready.
VITE_AUTH_ENABLED=false
# Public browser configuration only. Never put service_role or sb_secret_ here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional manual cloud backup. Requires auth and a configured database/function.
VITE_CLOUD_ENABLED=false
