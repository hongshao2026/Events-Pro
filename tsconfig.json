{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {"@/*": ["./*"]},
    "types": ["node", "vite/client"]
  },
  "include": ["app/**/*.tsx", "components/**/*.tsx", "lib/**/*.ts", "local-entry.tsx", "vite.config.ts"],
  "exclude": ["node_modules", "local-dist", "release", ".sites-runtime"]
}
