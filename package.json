{
  "name": "events-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-local.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "start": "vite preview --host 127.0.0.1",
    "lint": "eslint app components/planner components/auth lib local-entry.tsx vite.config.ts capacitor.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "test:state": "node tests/state.test.mjs",
    "test:agenda": "node tests/agenda.test.mjs",
    "test:ui": "node tests/ui.test.mjs",
    "test:auth": "node tests/auth.test.mjs",
    "test:auth:ui": "node tests/auth-ui.test.mjs",
    "build:web": "vite build --outDir web-dist",
    "verify": "node scripts/verify.mjs",
    "build:ios": "node scripts/build-ios.mjs",
    "ios:sync": "npm run build:ios && cap sync ios && node scripts/configure-ios.mjs",
    "ios:open": "cap open ios",
    "ios:icon": "node scripts/render-app-icon.mjs",
    "ios:check": "node scripts/check-ios.mjs",
    "legal:preview": "node scripts/build-legal-site.mjs --draft",
    "legal:build": "node scripts/build-legal-site.mjs",
    "release:check": "node scripts/check-release.mjs",
    "ios:release": "npm run release:check && node scripts/build-ios.mjs --release && cap sync ios && node scripts/configure-ios.mjs",
    "test:release:ui": "node tests/release-ui.test.mjs",
    "test:native:ui": "node tests/native-ui.test.mjs"
  },
  "dependencies": {
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.31.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.6",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.6",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright": "1.62.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  }
}
